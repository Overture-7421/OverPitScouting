# Copy to .env and fill in your values. Never commit .env.

# ── Dev-server proxy (not embedded in bundle) ─────────────────────
# Used by vite.config.ts to inject auth headers via the local dev proxy.
FTC_API_USERNAME=your_ftc_username
FTC_API_SECRET=your_ftc_secret_uuid

TBA_API_SECRET=your_tba_auth_key
TBA_API_DESCRIPTION=PitScoutingAnalyzer

# ── Production client-side (embedded in bundle at build time) ─────

# TBA — supports browser CORS, key embedded directly.
VITE_TBA_API_SECRET=your_tba_auth_key

# FTC Events API — does NOT support browser CORS. Requests are routed through
# the Cloudflare Worker in proxy-worker/. Deploy it first, then paste the URL:
VITE_FTC_PROXY_URL=https://ftc-api-proxy.YOUR-SUBDOMAIN.workers.dev
